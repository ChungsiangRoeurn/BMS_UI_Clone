<UserControl
    x:Class="BMS_Clone.Views.Pages.KiaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BMS_Clone.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BMS_Clone.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:KiaViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">


    <Grid Background="Transparent">

        <Line
            Margin="0,0,0,10"
            Stroke="White"
            StrokeThickness="2"
            X1="0"
            X2="2000"
            Y1="0"
            Y2="0" />


        <ScrollViewer
            Margin="3"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">

            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:IoTControl
                            Margin="10"
                            AccentColor="{Binding AccentColor}"
                            Current="{Binding Current}"
                            Energy="{Binding Energy}"
                            IconKind="{Binding IconKind}"
                            Power="{Binding Power}"
                            Status="{Binding Status}"
                            Voltage="{Binding Voltage}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>