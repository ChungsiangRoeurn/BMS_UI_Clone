<UserControl
    x:Class="BMS_Clone.Views.Controls.IoTControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:BMS_Clone.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="Transparent">

        <Border
            Width="280"
            Height="370"
            Background="#303030"
            CornerRadius="20">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    Opacity="0.5"
                    ShadowDepth="8" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="135" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconMaterial
                            Grid.Column="0"
                            Width="25"
                            Height="25"
                            Margin="20,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Foreground="White"
                            Kind="Star" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,20,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            FontFamily="Leelawadee UI Semilight"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding Status, ElementName=Root}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid>
                                <Ellipse
                                    Width="48"
                                    Height="48"
                                    Fill="Transparent"
                                    Stroke="{Binding AccentColor, ElementName=Root}"
                                    StrokeThickness="3" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    Foreground="White"
                                    Text="{Binding Voltage, ElementName=Root}" />
                            </Grid>
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="White"
                                Text="Voltage" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid>
                                <Ellipse
                                    Width="50"
                                    Height="50"
                                    Fill="Transparent"
                                    Stroke="{Binding AccentColor, ElementName=Root}"
                                    StrokeThickness="3" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    Foreground="White"
                                    Text="{Binding Current, ElementName=Root}" />
                            </Grid>

                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="White"
                                Text="Current" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid>
                                <Ellipse
                                    Width="50"
                                    Height="50"
                                    Fill="Transparent"
                                    Stroke="{Binding AccentColor, ElementName=Root}"
                                    StrokeThickness="3" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    Foreground="White"
                                    Text="{Binding Power, ElementName=Root}" />
                            </Grid>

                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="White"
                                Text="Power" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid>
                                <Ellipse
                                    Width="50"
                                    Height="50"
                                    Fill="Transparent"
                                    Stroke="{Binding AccentColor, ElementName=Root}"
                                    StrokeThickness="3" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    Foreground="White"
                                    Text="{Binding Energy, ElementName=Root}" />
                            </Grid>

                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="White"
                                Text="Energy" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Width="200"
                    Height="200"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">

                    <Ellipse
                        Width="190"
                        Height="190"
                        Panel.ZIndex="0"
                        Fill="#222222">

                        <Ellipse.Effect>
                            <DropShadowEffect
                                BlurRadius="25"
                                Opacity="0.8"
                                ShadowDepth="10" />
                        </Ellipse.Effect>

                    </Ellipse>

                    <Ellipse
                        Width="200"
                        Height="200"
                        Panel.ZIndex="1"
                        Fill="#404040" />

                    <Ellipse
                        Width="200"
                        Height="200"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Panel.ZIndex="3"
                        Fill="Transparent"
                        Stroke="{Binding AccentColor, ElementName=Root}"
                        StrokeDashArray="3 50"
                        StrokeThickness="12" />

                    <Ellipse
                        Width="175"
                        Height="175"
                        Panel.ZIndex="2"
                        Fill="#404040"
                        Stroke="#111111"
                        StrokeThickness="0.5">

                        <Ellipse.Effect>
                            <DropShadowEffect
                                BlurRadius="20"
                                Opacity="0.85"
                                ShadowDepth="0"
                                Color="Gray" />
                        </Ellipse.Effect>

                    </Ellipse>

                    <Path
                        Data="{Binding LoadingArc}"
                        Stroke="#00BFFF"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="10" />


                    <iconPacks:PackIconMaterial
                        Width="50"
                        Height="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Panel.ZIndex="5"
                        Foreground="White"
                        Kind="{Binding IconKind, ElementName=Root}" />

                </Grid>
            </Grid>

        </Border>

    </Grid>
</UserControl>
