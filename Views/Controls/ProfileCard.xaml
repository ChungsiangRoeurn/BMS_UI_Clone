<UserControl
    x:Class="BMS_Clone.Views.Pages.ProfileCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="170"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Border
        Width="360"
        Height="200"
        Padding="20"
        Background="#333333"
        CornerRadius="18">

        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Opacity="0.25"
                ShadowDepth="3" />
        </Border.Effect>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Avatar  -->
            <Grid Width="72" Height="72">

                <Ellipse Stroke="#3A3A3A" StrokeThickness="2">

                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Avatar, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Ellipse.Fill>

                </Ellipse>

                <Ellipse
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="{Binding StatusColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Stroke="#242424"
                    StrokeThickness="2" />

            </Grid>

            <!--  User Info  -->
            <StackPanel
                Grid.Column="1"
                Margin="18,0"
                VerticalAlignment="Center">

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding UserName, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="13"
                    Foreground="#B8B8B8"
                    Text="{Binding Email, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <Border
                    Margin="0,12,0,0"
                    Padding="10,4"
                    HorizontalAlignment="Left"
                    Background="#303030"
                    CornerRadius="10">

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#55D6FF"
                        Text="{Binding Role, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                </Border>

            </StackPanel>

            <!--  Action Button  -->
            <Button
                Grid.Column="2"
                Width="40"
                Height="40"
                Background="#333333"
                BorderBrush="Transparent"
                Content="⋮"
                Cursor="Hand"
                FontSize="18">

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050" />
                            </Trigger>

                        </Style.Triggers>

                    </Style>
                </Button.Style>

            </Button>

        </Grid>

    </Border>

</UserControl>